{
  "name": "@kestrel/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "validate:anchors": "tsx scripts/validateAnchors.ts",
    "choose:bearing": "tsx scripts/chooseAlternateBearing.ts",
    "fetch:rose": "tsx scripts/fetchWindRose.ts",
    "choose:test-scene": "tsx scripts/chooseTestingScene.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.4.1",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
